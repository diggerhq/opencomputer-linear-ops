# Runtime configuration. Linear authentication comes from the managed
# connection declared by useService("linear"); no Linear token belongs here.
LINEAR_TEAM_ID=
GITHUB_REPOSITORY=
REPORT_DESTINATION_KEY=engineering-triage
REPORT_TIMEZONE=America/Los_Angeles
STALE_AFTER_DAYS=7
RECENTLY_COMPLETED_DAYS=14

# AgentMail delivery. Upload AGENTMAIL_API_KEY as a write-only project secret.
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=
DELIVERY_RECIPIENT_EMAIL=
DELIVERY_DESTINATION_KEY=engineering-status
